NODE_ENV=development

# ── Core (all environments) ───────────────────────────────────────────────────
# Shares the backend's Postgres DB and Prisma schema — same DATABASE_URL as backend/.env.
# Required at boot; process exits if unset.
DATABASE_URL=

# HMAC key backing computeHmac() — the FROM/handle match for every Telegram,
# Reddit, and phone challenge validation (challenge.service.js). Required at
# boot; process exits if unset. Must match backend/.env exactly — both
# processes HMAC the same fields against the same DB rows.
HMAC_SECRET=replace-with-64-char-hex-string

# ── ALE key material (boot-checked, not actually exercised by this service) ──
# Required at boot (at least one of the two below must be set — process exits
# if both are unset), because crypto.util.js's encrypt()/decrypt() functions
# live in the same shared module as computeHmac(). In practice this service
# never calls encrypt()/decrypt() — challenge.service.js only ever calls
# computeHmac() — so these values are never read again after the boot check.
# Set them anyway to satisfy the gate; use the same values as backend/.env.
ALE_ENCRYPTION_KEY=replace-with-different-64-char-hex-string
ALE_KMS_KEY_ARN=

# ── Reddit Social Listener (Sprint 2 — blocked on compliance review, keep false) ─
REDDIT_SOCIAL_LISTENER=false
# Required (fatal at boot) only when REDDIT_SOCIAL_LISTENER=true.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=

# ── Telegram Social Listener (Sprint 2) ───────────────────────────────────────
TELEGRAM_SOCIAL_LISTENER=false
# off | polling | webhook — never both; webhook in prod, polling for local dev
# only. Required to be exactly polling|webhook when TELEGRAM_SOCIAL_LISTENER=true,
# or the process exits fail-closed at boot.
TELEGRAM_LISTENER_MODE=off
# Required (fatal at boot) when TELEGRAM_SOCIAL_LISTENER=true, in both modes.
TELEGRAM_BOT_TOKEN=
# Required (fatal at boot) only in webhook mode. Validated against
# X-Telegram-Bot-Api-Secret-Token on every inbound webhook request.
TELEGRAM_WEBHOOK_SECRET=

# ── Android SMS Gateway (interim inbound provider — dev/staging only) ────────
# stub | android | telnyx — exactly one per environment; android prohibited in prod.
PHONE_LISTENER_PROVIDER=stub
# Required (fatal at boot) only when PHONE_LISTENER_PROVIDER=android. Mirrors
# the capcom6 app's Signing Key (Settings → Webhooks → Signing Key). Distinct
# from ALE_ENCRYPTION_KEY/HMAC_SECRET — verifies the inbound webhook signature,
# not challenge/handle matches. Rotate in app settings + env simultaneously.
ANDROID_FORWARDER_HMAC_SECRET=
# Read only when PHONE_LISTENER_PROVIDER=android; not boot-checked, defaults to
# 660 if unset.
ANDROID_FORWARDER_REPLAY_WINDOW_S=660

# Local-dev bind port when no PORT env var is auto-injected (Render injects
# PORT itself for the deployed web service). The server now always binds one
# of PORT / LISTENER_WEBHOOK_PORT / 8090, regardless of adapter/flag state —
# see CLAUDE_ENVIRONMENTS.md Render service topology trap #1.
LISTENER_WEBHOOK_PORT=8090

# ── Not in this file, on purpose ──────────────────────────────────────────────
# PHONE_MAINTENANCE_NOTICE — checked at boot (non-fatal warn if unset, so an
#   ops mistake surfaces early) but never read again after that. The value is
#   actually consumed by the backend API (verify.controller.js), not this
#   process. Set it in backend/.env, not here — this listener has no use for
#   the value itself.
# ANDROID_LISTENER_NUMBER, ANDROID_HEARTBEAT_STALE_AFTER_S — backend-only vars
#   (read by verify.controller.js to build the /initiate response and decide
#   stub-fallback degradation). No code path in this service reads either one.
# JWT_SECRET, GOOGLE_CLIENT_ID/SECRET, APPLE_*, GITHUB_PAT, CATEGORY_B_*,
#   STAGING_PHONE_WHITELIST, STAGING_PHONE_STUB_DELAY_MS, CORS_ORIGIN — all
#   main-API concerns (backend/.env.example); jwt.util.js and
#   handleCanonicalization.util.js are never imported anywhere in this
#   service's dependency graph, and flags/features.js (also unreachable here)
#   would be a red herring even if it were — its TELEGRAM_SOCIAL_LISTENER /
#   REDDIT_SOCIAL_LISTENER fields are hardcoded constants, not env reads; this
#   process reads the real env vars directly.
