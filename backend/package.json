{
  "name": "primid-backend",
  "version": "1.0.0",
  "description": "primID identity system backend",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:migrate": "npx prisma migrate dev",
    "db:studio": "npx prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:generate": "npx prisma generate",
    "db:backfill-handle-ale": "node prisma/migrations/20260422000001_add_handle_ale_columns/backfill.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.1",
    "express-rate-limit": "7.5.1",
    "express-validator": "7.3.1",
    "helmet": "7.2.0",
    "jose": "4.15.9",
    "morgan": "1.10.1",
    "prisma": "5.22.0",
    "twilio": "5.13.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "4.2.1",
    "jest": "30.3.0",
    "nodemon": "3.1.14",
    "supertest": "7.2.2"
  }
}
