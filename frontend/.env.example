# Backend API URL
# Production: set to your Render backend service URL (e.g. https://primid-backend.onrender.com)
# Development: http://localhost:3001
REACT_APP_API_URL=http://localhost:3001

# Google OAuth Client ID — must match the client ID used in the backend
REACT_APP_GOOGLE_CLIENT_ID=

# ── Local HTTPS dev only (do NOT set these in production) ──
# Uncomment and point to your local self-signed certs only when running CRA with HTTPS=true locally.
# These are never used in a production build.
# HTTPS=true
# SSL_CRT_FILE=../certs/cert.pem
# SSL_KEY_FILE=../certs/key.pem
