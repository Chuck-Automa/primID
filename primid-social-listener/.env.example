NODE_ENV=development

# Shares the backend's Postgres DB and Prisma schema — same DATABASE_URL as backend/.env.
DATABASE_URL=

# Must match backend/.env exactly — both processes decrypt/HMAC the same fields.
ALE_ENCRYPTION_KEY=replace-with-64-char-hex-string
ALE_KMS_KEY_ARN=
HMAC_SECRET=replace-with-different-64-char-hex-string

# ── Reddit Social Listener (Sprint 2) ────────────────────────────────────────
REDDIT_SOCIAL_LISTENER=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=

# ── Android SMS Gateway (interim inbound provider — dev/staging only) ────────
# Full spec: CLAUDE_SOCIAL_VERIFICATION.md "Android SMS Gateway Adapter".
# stub | android | telnyx — exactly one per environment; android prohibited in prod.
PHONE_LISTENER_PROVIDER=stub
# Mirrors the capcom6 app's Signing Key (Settings → Webhooks → Signing Key).
# Distinct from ALE_ENCRYPTION_KEY/HMAC_SECRET; rotate in app settings + env simultaneously.
ANDROID_FORWARDER_HMAC_SECRET=
ANDROID_FORWARDER_REPLAY_WINDOW_S=660

# Local-dev bind port when PHONE_LISTENER_PROVIDER=android and no PORT env var
# is auto-injected (Render injects PORT itself for the deployed web service).
LISTENER_WEBHOOK_PORT=8090
