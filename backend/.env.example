NODE_ENV=development
PORT=3001

# PostgreSQL — local dev example; Render injects this automatically from the linked DB
DATABASE_URL=postgresql://primid_user:your_password@localhost:5432/primid

# JWT — minimum 32 chars; use `openssl rand -base64 32` to generate
JWT_SECRET=replace-with-strong-random-secret-min-32-chars

# ── Application-Level Encryption (ALE) ──────────────────────────────────────
# AES-256-GCM key for encrypting phone_number and oauth_sub at rest.
# Dev/staging: 32-byte hex key — generate with: openssl rand -hex 32
# Production: leave blank and set ALE_KMS_KEY_ARN instead (KMS-derived data key).
ALE_ENCRYPTION_KEY=replace-with-64-char-hex-string

# AWS KMS key ARN for production ALE key management.
# When set, the app fetches a KMS-derived data key at startup (held in memory only).
# See utils/crypto.util.js TODO for KMS bootstrap implementation.
ALE_KMS_KEY_ARN=

# HMAC key for phone_number_hmac and oauth_sub_hmac lookup columns.
# MUST be a different secret from ALE_ENCRYPTION_KEY.
# Generate with: openssl rand -hex 32
HMAC_SECRET=replace-with-different-64-char-hex-string

# Twilio (leave blank in dev — OTP is logged to console as [DEV OTP])
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google OAuth — Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth — Apple Developer → Certificates, Identifiers & Profiles → Keys
# APPLE_CLIENT_ID must match the audience claim in Apple identity tokens
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# CORS — comma-separated list of allowed frontend origins
# Production: set to your Render frontend URL (e.g. https://primid-frontend.onrender.com)
CORS_ORIGIN=http://localhost:3000

# ── Staging access gate ───────────────────────────────────────────────────────
# Set NODE_ENV=staging in the staging environment.
# Only applicable when NODE_ENV=staging — ignored in dev and prod.
#
# Comma-separated E.164 phone numbers permitted to register/login via OTP in staging.
# Non-whitelisted numbers receive 403 DEMO_RESTRICTED.
# Demo slots use the 555-01xx reserved range (safe to publish):
#   +12025550101 through +12025550110
STAGING_OTP_WHITELIST=+12025550101,+12025550102,+12025550103,+12025550104,+12025550105,+12025550106,+12025550107,+12025550108,+12025550109,+12025550110

# Fixed OTP code returned for all whitelisted numbers in staging.
# Communicated to reviewers out-of-band — never returned in the API response.
STAGING_OTP_FIXED_CODE=123456
